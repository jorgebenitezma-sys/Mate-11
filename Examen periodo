/* ---------- login ---------- */
document.getElementById("form-login").addEventListener("submit", async function(evento){
  evento.preventDefault();
  const errorLogin = document.getElementById("login-error");
  const cargando = document.getElementById("login-cargando");
  errorLogin.classList.add("oculto");

  const nombre = document.getElementById("campo-nombre").value.trim();
  const grupo = document.getElementById("campo-grupo").value;

  if(!nombre || !grupo){
    errorLogin.textContent = "Completa tu nombre y grupo antes de continuar.";
    errorLogin.classList.remove("oculto");
    return;
  }

  // IMPORTANTE: la pantalla completa se pide AQUÍ, de inmediato, dentro del mismo
  // clic del botón — los navegadores solo la permiten como reacción directa a una
  // acción del usuario. Si se pide después de un "await" (como una llamada de red),
  // el navegador la bloquea en silencio. Por eso se solicita antes de cualquier otra
  // validación, y se revierte más abajo si el alumno termina bloqueado.
  if(USAR_PANTALLA_COMPLETA && PANTALLA_COMPLETA_SOPORTADA){
    document.documentElement.requestFullscreen().catch(()=>{ /* el navegador del alumno no lo permitió; seguimos sin pantalla completa */ });
  }

  const horario = HORARIOS_GRUPOS[grupo];
  const ahora = new Date();
  const apertura = new Date(horario.apertura);
  const cierre = new Date(horario.cierre);

  if(ahora < apertura){
    mostrarBloqueo(`El examen para el grupo ${grupo} abrirá el ${formatearFecha(horario.apertura)}. Vuelve a intentarlo en ese horario.`);
    salirDePantallaCompleta();
    return;
  }
  if(ahora > cierre){
    mostrarBloqueo(`El examen para el grupo ${grupo} cerró el ${formatearFecha(horario.cierre)}. Contacta a tu profesor si tienes dudas.`);
    salirDePantallaCompleta();
    return;
  }

  const clave = claveAlumno(nombre, grupo);
  const guardado = localStorage.getItem(clave);

  if(guardado){
    const sesionGuardada = JSON.parse(guardado);
    if(sesionGuardada.estado === "completado"){
      claveSesionActual = clave;
      mostrarBloqueo("Este examen ya fue presentado con este nombre y grupo en este dispositivo. No es posible volver a presentarlo.", true);
      salirDePantallaCompleta();
      return;
    }
    // había un intento en progreso (por ejemplo, se cerró el navegador sin querer)
    const limiteTiempo = Math.min(sesionGuardada.inicio + DURACION_MINUTOS*60000, cierre.getTime());
    if(Date.now() < limiteTiempo){
      claveSesionActual = clave;
      sesionActual = sesionGuardada;
      iniciarInterfazExamen(true);
      return;
    } else {
      // el tiempo ya se venció mientras estaba cerrado: se entrega automáticamente
      claveSesionActual = clave;
      sesionActual = sesionGuardada;
      entregarExamen(true);
      salirDePantallaCompleta();
      return;
    }
  }

  // Verificación opcional en Google Sheets por si el alumno cambió de dispositivo.
  cargando.classList.remove("oculto");
  const yaPresentadoServidor = await verificarEnvioPrevio(nombre, grupo);
  cargando.classList.add("oculto");
  if(yaPresentadoServidor){
    claveSesionActual = clave;
    mostrarBloqueo("Según nuestros registros, ya presentaste este examen (posiblemente desde otro dispositivo). No es posible volver a presentarlo.", true);
    salirDePantallaCompleta();
    return;
  }

  claveSesionActual = clave;
  sesionActual = {
    nombre, grupo,
    horarioApertura: horario.apertura,
    horarioCierre: horario.cierre,
    inicio: Date.now(),
    respuestas: [],
    ordenOpciones: generarOrdenOpciones(),
    salidas: 0,
    tiempoFueraTotal: 0,
    eventosCopiarPegar: 0,
    capturasDetectadas: 0,
    cambiosVentanaDetectados: 0,
    bitacora: [`${new Date().toLocaleTimeString("es-MX")} — Examen iniciado.`],
    estado: "en_progreso"
  };
  guardarSesion();
  iniciarInterfazExamen(false);
});

/* Genera, una sola vez por alumno, un orden aleatorio para las opciones de cada
   pregunta (opción múltiple, Verdadero/Falso, relacionar y clasificar). Se guarda
   en la sesión para que el orden no cambie si el alumno navega entre preguntas o
   si recarga la página. Los valores guardados en las respuestas del alumno siguen
   siendo el índice ORIGINAL de la opción, así que la calificación no cambia. */
function generarOrdenOpciones(){
  return EXAMEN.preguntas.map(pregunta=>{
    if(pregunta.tipo === "seleccion" || pregunta.tipo === "multiple" || pregunta.tipo === "asociar"){
      return mezclarIndices(pregunta.opciones.length);
    }
    return null; // "abierta", "abierta_multiple" y "graficar" no tienen opciones que mezclar
  });
}

function mezclarIndices(cantidad){
  const indices = Array.from({ length: cantidad }, (_, i) => i);
  for(let i = indices.length - 1; i > 0; i--){
    const j = Math.floor(Math.random() * (i + 1));
    [indices[i], indices[j]] = [indices[j], indices[i]];
  }
  return indices;
}

/* Devuelve el orden mezclado de opciones para la pregunta "indice". Si la sesión
   viene de antes de que existiera esta función (o el arreglo está incompleto por
   cualquier motivo), genera el orden en ese momento y lo guarda, para que el
   examen nunca se rompa por una sesión antigua. */
function obtenerOrdenOpciones(indice, pregunta){
  if(!Array.isArray(sesionActual.ordenOpciones)){
    sesionActual.ordenOpciones = generarOrdenOpciones();
    guardarSesion();
  }
  if(!Array.isArray(sesionActual.ordenOpciones[indice])){
    const cantidad = (pregunta.tipo === "seleccion" || pregunta.tipo === "multiple" || pregunta.tipo === "asociar")
      ? pregunta.opciones.length : 0;
    sesionActual.ordenOpciones[indice] = cantidad > 0 ? mezclarIndices(cantidad) : null;
    guardarSesion();
  }
  return sesionActual.ordenOpciones[indice];
}

function salirDePantallaCompleta(){
  if(document.fullscreenElement){
    document.exitFullscreen().catch(()=>{});
  }
}

/* ---------- render y lógica del examen ---------- */
function iniciarInterfazExamen(reanudando){
  examenActivo = true;
  const datos = EXAMEN;

  document.getElementById("info-alumno").textContent = `${sesionActual.nombre} — Grupo ${sesionActual.grupo}${reanudando ? " (intento reanudado)" : ""}`;
  actualizarContadorVisible();

  const lecturaDiv = document.getElementById("lectura-contenedor");
  lecturaDiv.innerHTML = "";
  if(datos.lectura && datos.lectura.trim() !== ""){
    const bloque = document.createElement("div");
    bloque.className = "lectura";
    bloque.textContent = datos.lectura;
    lecturaDiv.appendChild(bloque);
  }

  mostrarSoloVista("vista-examen");

  if(USAR_PANTALLA_COMPLETA && PANTALLA_COMPLETA_SOPORTADA){
    document.documentElement.requestFullscreen().catch(()=>{ /* si el navegador lo impide, seguimos sin pantalla completa */ });
  }

  const limiteTiempo = Math.min(sesionActual.inicio + DURACION_MINUTOS*60000, new Date(sesionActual.horarioCierre).getTime());
  iniciarCronometro(limiteTiempo);
  iniciarMarcaAgua();

  if(typeof sesionActual.preguntaActual !== "number") sesionActual.preguntaActual = 0;
  renderPreguntaActual();
}

/* ---------- navegación libre entre preguntas ---------- */
function renderPreguntaActual(){
  const datos = EXAMEN;
  const total = datos.preguntas.length;
  const indice = sesionActual.preguntaActual;
  const pregunta = datos.preguntas[indice];
  const ordenOpciones = obtenerOrdenOpciones(indice, pregunta);

  document.getElementById("progreso-texto").textContent = `Pregunta ${indice+1} de ${total}`;
  document.getElementById("barra-progreso-relleno").style.width = `${Math.round(((indice+1)/total)*100)}%`;
  document.getElementById("pregunta-error").classList.add("oculto");

  renderNavegadorPreguntas();

  const contenedor = document.getElementById("pregunta-actual-contenedor");
  contenedor.innerHTML = "";

  const div = document.createElement("div");
  div.className = "pregunta";

  if(pregunta.imagen){
    const img = document.createElement("img");
    img.src = pregunta.imagen;
    img.className = "imagen-pregunta";
    img.alt = "Imagen de la pregunta";
    div.appendChild(img);
  }

  const p = document.createElement("p");
  p.className = "enunciado";
  p.textContent = `${indice+1}. ${pregunta.pregunta}`;
  div.appendChild(p);

  if(pregunta.tipo === "asociar"){
    if(!Array.isArray(sesionActual.respuestas[indice])){
      sesionActual.respuestas[indice] = new Array(pregunta.items.length).fill(undefined);
    }
    pregunta.items.forEach((textoItem, indiceItem)=>{
      const fila = document.createElement("div");
      fila.className = "opcion";
      fila.style.display = "block";
      const etiqueta = document.createElement("div");
      etiqueta.style.fontWeight = "600";
      etiqueta.style.marginBottom = "4px";
      etiqueta.textContent = textoItem;
      fila.appendChild(etiqueta);
      const select = document.createElement("select");
      const opcionVacia = document.createElement("option");
      opcionVacia.value = "";
      opcionVacia.textContent = "-- Selecciona una opción --";
      select.appendChild(opcionVacia);
      pregunta.opciones.forEach((_, i)=>{
        const indiceOpcion = ordenOpciones[i];
        const textoOpcion = pregunta.opciones[indiceOpcion];
        const opt = document.createElement("option");
        opt.value = indiceOpcion;
        opt.textContent = textoOpcion;
        if(sesionActual.respuestas[indice][indiceItem] === indiceOpcion) opt.selected = true;
        select.appendChild(opt);
      });
      select.addEventListener("change", ()=>{
        sesionActual.respuestas[indice][indiceItem] = select.value === "" ? undefined : Number(select.value);
        guardarSesion();
        renderNavegadorPreguntas();
      });
      fila.appendChild(select);
      div.appendChild(fila);
    });
  } else if(pregunta.tipo === "abierta" || pregunta.tipo === "graficar"){
    if(pregunta.tipo === "graficar"){
      const avisoGrafica = document.createElement("p");
      avisoGrafica.className = "aviso-manual";
      avisoGrafica.textContent = "📐 Resuelve y traza esta gráfica en tu hoja de cuadrícula. En el cuadro de abajo describe los elementos que incluiste (ejes, escala, puntos, rectas, ángulos) para que tu profesor(a) los revise junto con tu hoja.";
      div.appendChild(avisoGrafica);
    }
    const area = document.createElement("textarea");
    area.className = "respuesta-abierta";
    area.rows = 6;
    area.placeholder = "Escribe tu respuesta aquí…";
    area.value = (typeof sesionActual.respuestas[indice] === "string") ? sesionActual.respuestas[indice] : "";
    area.addEventListener("input", ()=>{
      sesionActual.respuestas[indice] = area.value;
      guardarSesion();
      renderNavegadorPreguntas();
    });
    div.appendChild(area);
    const nota = document.createElement("p");
    nota.className = "ayuda";
    nota.textContent = `Esta pregunta vale ${pregunta.puntosMaximos} punto(s) y será calificada manualmente por tu profesor(a).`;
    div.appendChild(nota);
  } else if(pregunta.tipo === "multiple"){
    if(!Array.isArray(sesionActual.respuestas[indice])){
      sesionActual.respuestas[indice] = [];
    }
    pregunta.opciones.forEach((_, i)=>{
      const indiceOpcion = ordenOpciones[i];
      const opcionTexto = pregunta.opciones[indiceOpcion];
      const fila = document.createElement("label");
      fila.className = "opcion";
      const casilla = document.createElement("input");
      casilla.type = "checkbox";
      casilla.value = indiceOpcion;
      casilla.checked = sesionActual.respuestas[indice].includes(indiceOpcion);
      casilla.addEventListener("change", ()=>{
        const actuales = sesionActual.respuestas[indice];
        if(casilla.checked){
          if(!actuales.includes(indiceOpcion)) actuales.push(indiceOpcion);
        } else {
          sesionActual.respuestas[indice] = actuales.filter(v => v !== indiceOpcion);
        }
        guardarSesion();
        renderNavegadorPreguntas();
      });
      fila.appendChild(casilla);
      const span = document.createElement("span");
      span.textContent = opcionTexto;
      fila.appendChild(span);
      div.appendChild(fila);
    });
    const nota = document.createElement("p");
    nota.className = "ayuda";
    nota.textContent = "Esta pregunta puede tener más de una respuesta correcta: marca todas las que apliquen.";
    div.appendChild(nota);
  } else if(pregunta.tipo === "abierta_multiple"){
    if(!Array.isArray(sesionActual.respuestas[indice])){
      sesionActual.respuestas[indice] = new Array(pregunta.subpreguntas.length).fill("");
    }
    pregunta.subpreguntas.forEach((textoSub, indiceSub)=>{
      const bloque = document.createElement("div");
      bloque.className = "subpregunta-abierta";
      const etiqueta = document.createElement("label");
      etiqueta.textContent = textoSub;
      bloque.appendChild(etiqueta);
      const area = document.createElement("textarea");
      area.className = "respuesta-abierta";
      area.rows = 3;
      area.placeholder = "Escribe tu respuesta aquí…";
      area.value = sesionActual.respuestas[indice][indiceSub] || "";
      area.addEventListener("input", ()=>{
        sesionActual.respuestas[indice][indiceSub] = area.value;
        guardarSesion();
        renderNavegadorPreguntas();
      });
      bloque.appendChild(area);
      div.appendChild(bloque);
    });
    const nota = document.createElement("p");
    nota.className = "ayuda";
    nota.textContent = `Este caso vale ${pregunta.puntosMaximos} punto(s) en total y será calificado manualmente por tu profesor(a).`;
    div.appendChild(nota);
  } else {
    pregunta.opciones.forEach((_, i)=>{
      const indiceOpcion = ordenOpciones[i];
      const opcionTexto = pregunta.opciones[indiceOpcion];
      const fila = document.createElement("label");
      fila.className = "opcion";
      const radio = document.createElement("input");
      radio.type = "radio";
      radio.name = `pregunta_actual`;
      radio.value = indiceOpcion;
      if(sesionActual.respuestas[indice] === indiceOpcion) radio.checked = true;
      radio.addEventListener("change", ()=>{
        sesionActual.respuestas[indice] = indiceOpcion;
        guardarSesion();
        renderNavegadorPreguntas();
      });
      fila.appendChild(radio);
      const span = document.createElement("span");
      span.textContent = opcionTexto;
      fila.appendChild(span);
      div.appendChild(fila);
    });
  }
  contenedor.appendChild(div);

  document.getElementById("btn-anterior").disabled = (indice === 0);
  document.getElementById("btn-siguiente").disabled = (indice === total - 1);
}

function renderNavegadorPreguntas(){
  const datos = EXAMEN;
  const contenedor = document.getElementById("navegador-preguntas");
  contenedor.innerHTML = "";
  datos.preguntas.forEach((pregunta, indice)=>{
    const boton = document.createElement("button");
    boton.type = "button";
    boton.className = "nav-pregunta-btn";
    boton.textContent = indice + 1;
    if(indice === sesionActual.preguntaActual) boton.classList.add("actual");
    else if(estaCompleta(pregunta, sesionActual.respuestas[indice])) boton.classList.add("respondida");
    boton.title = `Ir a la pregunta ${indice+1}`;
    boton.addEventListener("click", ()=>{
      sesionActual.preguntaActual = indice;
      guardarSesion();
      renderPreguntaActual();
    });
    contenedor.appendChild(boton);
  });
}

function estaCompleta(pregunta, respuesta){
  if(pregunta.tipo === "asociar"){
    if(!Array.isArray(respuesta) || respuesta.length !== pregunta.items.length) return false;
    return respuesta.every(valor => valor !== undefined && valor !== null && valor !== "");
  }
  if(pregunta.tipo === "abierta" || pregunta.tipo === "graficar"){
    return typeof respuesta === "string" && respuesta.trim() !== "";
  }
  if(pregunta.tipo === "abierta_multiple"){
    if(!Array.isArray(respuesta) || respuesta.length !== pregunta.subpreguntas.length) return false;
    return respuesta.every(valor => typeof valor === "string" && valor.trim() !== "");
  }
  if(pregunta.tipo === "multiple"){
    return Array.isArray(respuesta) && respuesta.length > 0;
  }
  return respuesta !== undefined && respuesta !== null;
}

document.getElementById("btn-anterior").addEventListener("click", ()=>{
  if(sesionActual.preguntaActual > 0){
    sesionActual.preguntaActual--;
    guardarSesion();
    renderPreguntaActual();
  }
});

document.getElementById("btn-siguiente").addEventListener("click", ()=>{
  const total = EXAMEN.preguntas.length;
  if(sesionActual.preguntaActual < total - 1){
    sesionActual.preguntaActual++;
    guardarSesion();
    renderPreguntaActual();
  }
});

document.getElementById("btn-entregar").addEventListener("click", ()=>{
  const datos = EXAMEN;
  const sinResponder = [];
  datos.preguntas.forEach((pregunta, indice)=>{
    if(!estaCompleta(pregunta, sesionActual.respuestas[indice])) sinResponder.push(indice+1);
  });

  let mensaje = "¿Seguro que quieres entregar el examen? No podrás modificarlo después.";
  if(sinResponder.length > 0){
    mensaje = `Tienes ${sinResponder.length} pregunta(s) sin responder (número ${sinResponder.join(", ")}). ` +
      `¿Quieres entregar de todas formas? Si cancelas, puedes usar el panel de números para regresar a completarlas.`;
  }

  if(confirm(mensaje)){
    entregarExamen(false);
  }
});

/* ---------- marca de agua con los datos del alumno (disuasivo/rastreo de capturas) ---------- */
let intervaloMarcaAgua = null;
function textoMarcaAgua(){
  const hora = new Date().toLocaleString("es-MX", {dateStyle:"short", timeStyle:"medium"});
  return `${sesionActual.nombre} · Grupo ${sesionActual.grupo} · ${hora}`;
}
function dibujarMarcaAgua(){
  const contenedor = document.getElementById("marca-agua");
