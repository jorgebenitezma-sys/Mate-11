/* ---------- utilidades ---------- */
function normalizar(txt){
  return (txt || "").toString().normalize("NFD").replace(/[\u0300-\u036f]/g,"").toLowerCase().trim().replace(/\s+/g,"_");
}
function claveAlumno(nombre, grupo){
  return `examen_recta_${normalizar(grupo)}_${normalizar(nombre)}`;
}
function formatearFecha(valor){
  if(!valor) return "";
  const f = new Date(valor);
  return f.toLocaleString("es-MX", {dateStyle:"short", timeStyle:"short"});
}
function formatearDuracionMs(ms){
  const totalSeg = Math.max(0, Math.round(ms/1000));
  const min = Math.floor(totalSeg/60);
  const seg = totalSeg%60;
  return `${min}:${seg.toString().padStart(2,"0")}`;
}
