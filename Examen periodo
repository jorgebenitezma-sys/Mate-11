function iniciarMarcaAgua(){
  dibujarMarcaAgua();
  if(intervaloMarcaAgua) clearInterval(intervaloMarcaAgua);
  // Se vuelve a dibujar cada 20 segundos para que la hora quede siempre visible.
  intervaloMarcaAgua = setInterval(dibujarMarcaAgua, 20000);
}
function detenerMarcaAgua(){
  if(intervaloMarcaAgua) clearInterval(intervaloMarcaAgua);
  document.getElementById("marca-agua").innerHTML = "";
}

function iniciarCronometro(limiteTiempo){
  if(intervaloCronometro) clearInterval(intervaloCronometro);
  function actualizar(){
    const restanteMs = limiteTiempo - Date.now();
    const elemento = document.getElementById("cronometro");
    if(restanteMs <= 0){
      elemento.textContent = "0:00";
      clearInterval(intervaloCronometro);
      entregarExamen(true);
      return;
    }
    elemento.textContent = formatearDuracionMs(restanteMs);
  }
  actualizar();
  intervaloCronometro = setInterval(actualizar, 1000);
}

/* ---------- sistema antifraude: cambios de pestaña/ventana ---------- */
document.addEventListener("visibilitychange", ()=>{
