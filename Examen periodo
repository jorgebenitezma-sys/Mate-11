/* ---------- verificación en servidor (Google Sheets) de intentos previos ---------- */
async function verificarEnvioPrevio(nombre, grupo){
  if(!URL_GOOGLE_SHEETS) return false;
  try{
    const controlador = new AbortController();
    const limite = setTimeout(()=>controlador.abort(), 5000);
    const url = `${URL_GOOGLE_SHEETS}?accion=verificar&nombre=${encodeURIComponent(nombre)}&grupo=${encodeURIComponent(grupo)}`;
    const respuesta = await fetch(url, {signal: controlador.signal});
    clearTimeout(limite);
    const datos = await respuesta.json();
    return !!datos.yaPresentado;
  }catch(err){
    // Si falla la verificación (sin internet, script mal configurado, etc.)
    // NO bloqueamos al alumno por un problema técnico ajeno a él.
    return false;
  }
}

/* ---------- envío del registro final a Google Sheets ---------- */
function enviarAGoogleSheets(){
  const aviso = document.getElementById("texto-envio-sheets");
  const btnReenviar = document.getElementById("btn-reenviar");
  if(!URL_GOOGLE_SHEETS){
    aviso.textContent = "⚠️ No se configuró la conexión a Google Sheets; el registro quedó guardado solo en este dispositivo. Descarga tu comprobante en PDF y entrégalo a tu profesor.";
    return;
  }
  aviso.textContent = "Enviando tu registro a la hoja de control…";
  try{
    // Técnica de formulario oculto: es la forma más confiable de enviar datos a
    // Google Apps Script desde una página sencilla, evita bloqueos de seguridad
    // del navegador que a veces impiden que "fetch" complete el envío.
    const iframe = document.getElementById("marco-envio-oculto");
    const formulario = document.createElement("form");
    formulario.method = "POST";
    formulario.action = URL_GOOGLE_SHEETS;
    formulario.target = "marco-envio-oculto";
    formulario.style.display = "none";

    const campo = document.createElement("input");
    campo.type = "hidden";
    campo.name = "payload";
    campo.value = JSON.stringify(construirPayload());
    formulario.appendChild(campo);

    document.body.appendChild(formulario);
    formulario.submit();
    setTimeout(()=>{ document.body.removeChild(formulario); }, 3000);

    aviso.textContent = "✅ Registro enviado a la hoja de control.";
    btnReenviar.classList.add("oculto");
  }catch(err){
    aviso.textContent = "🚨 No se pudo enviar el registro a Google Sheets. Descarga tu comprobante en PDF como respaldo y usa el botón para reintentar.";
    btnReenviar.classList.remove("oculto");
  }
}
function obtenerCasosAbiertos(){
  const datos = EXAMEN;
  const casos = [];
  datos.preguntas.forEach((pregunta, indice)=>{
    if(pregunta.tipo === "abierta" || pregunta.tipo === "graficar"){
      const respuesta = (typeof sesionActual.respuestas[indice] === "string") ? sesionActual.respuestas[indice].trim() : "";
      const etiqueta = pregunta.tipo === "graficar" ? "Descripción de la gráfica" : "Respuesta";
      casos.push({
        numero: casos.length + 1,
        maximo: pregunta.puntosMaximos,
        texto: `${pregunta.pregunta}\n${etiqueta}: ${respuesta || "(sin responder)"}`
      });
    } else if(pregunta.tipo === "abierta_multiple"){
      const respuestasSub = Array.isArray(sesionActual.respuestas[indice]) ? sesionActual.respuestas[indice] : [];
      const texto = pregunta.subpreguntas.map((sub, i)=>{
        const respuesta = (respuestasSub[i] || "").trim();
        return `${sub}\nRespuesta: ${respuesta || "(sin responder)"}`;
      }).join("\n\n");
      casos.push({
        numero: casos.length + 1,
        maximo: pregunta.puntosMaximos,
        texto: `Caso: ${pregunta.pregunta}\n\n${texto}`
      });
    }
  });
  return casos;
}

function construirPayload(){
  const casosAbiertos = obtenerCasosAbiertos();
  const payload = {
    nombre: sesionActual.nombre,
    grupo: sesionActual.grupo,
    horarioApertura: formatearFecha(sesionActual.horarioApertura),
    horarioCierre: formatearFecha(sesionActual.horarioCierre),
    horaInicio: formatearFecha(sesionActual.inicio),
    horaEntrega: formatearFecha(sesionActual.horaEntrega),
    tiempoUsado: formatearDuracionMs(sesionActual.horaEntrega - sesionActual.inicio),
    autoEntregado: sesionActual.autoEntregado ? "Sí" : "No",
    intentos: 1,
    puntosAutomaticosObtenidos: sesionActual.correctas,
    puntosAutomaticosPosibles: sesionActual.total,
    puntosManualesPosibles: sesionActual.puntosManualesPosibles,
    puntosPosiblesTotales: sesionActual.puntosPosiblesTotales,
    calificacion: "Pendiente (revisar preguntas abiertas)",
    salidasSignificativas: sesionActual.salidas,
    tiempoFueraSegundos: sesionActual.tiempoFueraTotal,
    eventosCopiarPegar: sesionActual.eventosCopiarPegar,
    capturasDetectadas: sesionActual.capturasDetectadas || 0,
    cambiosVentanaDetectados: sesionActual.cambiosVentanaDetectados || 0,
    bitacora: sesionActual.bitacora.join(" | "),
    estado: calcularEstado(sesionActual)
  };
  casosAbiertos.forEach(c=>{
    payload[`casoAbierto${c.numero}Texto`] = c.texto;
    payload[`casoAbierto${c.numero}PuntosMaximos`] = c.maximo;
    payload[`casoAbierto${c.numero}PuntosAsignados`] = ""; // el profesor lo llena manualmente
  });
  return payload;
}
function calcularEstado(sesion){
  const capturas = sesion.capturasDetectadas || 0;
  const cambiosVentana = sesion.cambiosVentanaDetectados || 0;
  if(sesion.salidas >= LIMITE_SALIDAS_SOSPECHOSAS || sesion.tiempoFueraTotal >= LIMITE_SEGUNDOS_SOSPECHOSOS || sesion.eventosCopiarPegar > 0 || capturas > 0 || cambiosVentana > 0){
    return "🚨 Sospechoso";
  }
  if(sesion.salidas >= 1 || sesion.tiempoFueraTotal > 0){
    return "⚠️ Revisar";
  }
  return "✅ Normal";
}

