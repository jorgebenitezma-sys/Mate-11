      // fuera no había forma de mostrarle nada, ya que no estaba viendo la página).
      setTimeout(()=>{
        alert(`⚠️ Se detectó que saliste de esta pestaña (salida #${sesionActual.salidas}, ${segundosFuera} segundos fuera).\n\nEsto ha quedado registrado y será revisado por tu profesor.`);
      }, 150);
