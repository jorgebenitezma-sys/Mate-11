/* ---------- sistema antifraude: tecla de captura de pantalla ---------- */
/* AVISO IMPORTANTE Y HONESTO: en la mayoría de navegadores (especialmente Chrome
   en Windows), el sistema operativo intercepta la tecla "Impr Pant" ANTES de que
   llegue a la página — es decir, JavaScript nunca se entera de que se presionó.
   Esto no es una falla de este código: ningún sitio web puede evitarlo. Por eso
   la marca de agua (ver iniciarMarcaAgua) sigue siendo la protección real: si el
   alumno logra tomar una captura o foto, esa imagen queda identificada con su
   nombre. Lo de aquí abajo es un extra que atrapa el evento SOLO en los casos
   (algunos navegadores/versiones) donde sí llega a alcanzar a la página. */
let ultimaCapturaDetectadaMs = 0;
function posibleCaptura(evento){
  if(!examenActivo) return;

  const esImprPant = evento.key === "PrintScreen";
  // Windows + Shift + S (Recorte y anotación / Snipping). El navegador rara vez
  // recibe la tecla Windows como modificador confiable, por eso solo exigimos
  // Shift + S. Puede dar algún falso positivo si el alumno escribe una "S"
  // mayúscula normal, pero en un examen de opción múltiple eso no ocurre.
  const esSnipWindows = evento.shiftKey && (evento.key === "S" || evento.key === "s");
  // macOS: Cmd+Shift+3 (pantalla completa), Cmd+Shift+4 (selección), Cmd+Shift+5 (barra de captura/grabación).
  const esCapturaMac = evento.metaKey && evento.shiftKey && ["3","4","5"].includes(evento.key);

  if(!(esImprPant || esSnipWindows || esCapturaMac)) return;

  // Evita contar el mismo intento dos veces si el navegador dispara keydown Y keyup,
  // o si varias teclas de la misma combinación disparan eventos por separado.
  const ahora = Date.now();
  if(ahora - ultimaCapturaDetectadaMs < 1000) return;
  ultimaCapturaDetectadaMs = ahora;

  sesionActual.capturasDetectadas = (sesionActual.capturasDetectadas || 0) + 1;
  const combinacion = esImprPant ? "Impr Pant" : esSnipWindows ? "Win+Shift+S" : `Cmd+Shift+${evento.key}`;
  registrarEvento(`Posible intento de captura de pantalla detectado (combinación: ${combinacion}).`);
}
document.addEventListener("keydown", posibleCaptura);
document.addEventListener("keyup", posibleCaptura);

/* ---------- sistema antifraude: intento de cambiar de aplicación/ventana (Alt+Tab, Cmd+Tab) ---------- */
/* MISMO AVISO HONESTO QUE ARRIBA: en la gran mayoría de sistemas operativos, el propio
   sistema operativo intercepta Alt+Tab (Windows/Linux) o Cmd+Tab (macOS) para mostrar el
   selector de aplicaciones ANTES de que la tecla "Tab" llegue al navegador — es decir,
   muchas veces JavaScript nunca se entera. Por eso la protección real contra cambios de
   aplicación sigue siendo "visibilitychange" y "fullscreenchange" (arriba): en cuanto el
   alumno realmente cambia de aplicación, la pestaña se oculta o el examen sale de pantalla
   completa, y eso YA se cuenta como salida con el tiempo exacto que estuvo fuera. Lo de aquí
   abajo es una capa adicional que solo atrapa el intento en los casos (algunos
   navegadores/atajos) donde la combinación sí alcanza a disparar el evento en la página. */
let ultimoCambioVentanaDetectadoMs = 0;
function posibleCambioVentana(evento){
  if(!examenActivo) return;

  // Windows / Linux: Alt+Tab (cambiar de aplicación) y Alt+Esc (ciclar ventanas).
  const esAltTabWindows = evento.altKey && (evento.key === "Tab" || evento.key === "Escape");
  // macOS: Cmd+Tab (cambiar de aplicación) y Cmd+` (ciclar ventanas de la misma aplicación).
  const esCmdTabMac = evento.metaKey && (evento.key === "Tab" || evento.key === "`");

  if(!(esAltTabWindows || esCmdTabMac)) return;

  // Evita contar el mismo intento varias veces si el navegador dispara varios eventos
  // seguidos para la misma combinación.
  const ahora = Date.now();
  if(ahora - ultimoCambioVentanaDetectadoMs < 1000) return;
  ultimoCambioVentanaDetectadoMs = ahora;

  sesionActual.cambiosVentanaDetectados = (sesionActual.cambiosVentanaDetectados || 0) + 1;
  const combinacion = esAltTabWindows
    ? (evento.key === "Tab" ? "Alt+Tab" : "Alt+Esc")
    : (evento.key === "Tab" ? "Cmd+Tab" : "Cmd+`");
  registrarEvento(`Posible intento de cambio de aplicación/ventana detectado (combinación: ${combinacion}).`);
}
document.addEventListener("keydown", posibleCambioVentana);

/* ---------- calificación y entrega ---------- */
function entregarExamen(autoEntregado){
  if(!examenActivo) { // ya se había entregado (por ejemplo, el cronómetro llegó a 0 dos veces)
    return;
  }
  examenActivo = false;
  if(intervaloCronometro) clearInterval(intervaloCronometro);
  detenerMarcaAgua();
  document.getElementById("bloqueo-pantalla-completa").classList.add("oculto");

  const datos = EXAMEN;
  let puntosAutoObtenidos = 0;
  let puntosAutoPosibles = 0;
  let puntosManualesPosibles = 0;
  datos.preguntas.forEach((pregunta, indice)=>{
    const respuesta = sesionActual.respuestas[indice];
    if(pregunta.tipo === "asociar"){
      puntosAutoPosibles += pregunta.items.length;
      pregunta.items.forEach((_, indiceItem)=>{
        if(Array.isArray(respuesta) && respuesta[indiceItem] === pregunta.correctas[indiceItem]) puntosAutoObtenidos++;
      });
    } else if(pregunta.tipo === "abierta" || pregunta.tipo === "abierta_multiple" || pregunta.tipo === "graficar"){
      puntosManualesPosibles += pregunta.puntosMaximos;
    } else if(pregunta.tipo === "multiple"){
      puntosAutoPosibles += 1;
      const marcadas = Array.isArray(respuesta) ? [...respuesta].sort((a,b)=>a-b) : [];
      const correctas = [...pregunta.correctas].sort((a,b)=>a-b);
      const coincide = marcadas.length === correctas.length && marcadas.every((v,i) => v === correctas[i]);
      if(coincide) puntosAutoObtenidos++;
    } else {
      puntosAutoPosibles += 1;
      if(respuesta === pregunta.correcta) puntosAutoObtenidos++;
    }
  });
  const puntosPosiblesTotales = puntosAutoPosibles + puntosManualesPosibles;

  sesionActual.estado = "completado";
  sesionActual.horaEntrega = Date.now();
  sesionActual.autoEntregado = autoEntregado;
  sesionActual.correctas = puntosAutoObtenidos;
  sesionActual.total = puntosAutoPosibles;
  sesionActual.puntosManualesPosibles = puntosManualesPosibles;
  sesionActual.puntosPosiblesTotales = puntosPosiblesTotales;
  sesionActual.calificacion = null; // pendiente: hay preguntas de calificación manual
  registrarEvento(autoEntregado ? "Examen entregado automáticamente (se acabó el tiempo)." : "Examen entregado por el alumno.");
  guardarSesion();

  // IMPORTANTE: "examenActivo" ya se puso en false al inicio de esta función (arriba).
  // Los listeners de "fullscreenchange" y "visibilitychange" revisan ese valor y se
  // detienen de inmediato si es false, así que salir de pantalla completa AQUÍ (al
  // entregar) nunca se cuenta como una salida sospechosa: el examen ya terminó.
  if(document.fullscreenElement){
    document.exitFullscreen().catch(()=>{});
  }

  document.getElementById("texto-calificacion").textContent = `${puntosAutoObtenidos} / ${puntosAutoPosibles} pts automáticos`;
  document.getElementById("texto-detalle-resultado").innerHTML =
    `Puntos automáticos obtenidos (opción múltiple, selección múltiple, Verdadero/Falso y relacionar): <b>${puntosAutoObtenidos} de ${puntosAutoPosibles}</b>.<br>` +
    `Puntos pendientes de revisión manual (preguntas abiertas y de graficación): <b>${puntosManualesPosibles}</b> (tu profesor(a) los asignará después de leer tus respuestas y revisar tus gráficas en papel).<br>` +
    `Puntaje total posible del examen: ${puntosPosiblesTotales} puntos.<br>` +
    `Tiempo usado: ${formatearDuracionMs(sesionActual.horaEntrega - sesionActual.inicio)}. ` +
    `Salidas detectadas (pestaña o pantalla completa): ${sesionActual.salidas || 0}.`;
  document.getElementById("aviso-calificacion-pendiente").classList.remove("oculto");
  mostrarSoloVista("vista-resultados");

  enviarAGoogleSheets();
}

document.getElementById("btn-reenviar").addEventListener("click", enviarAGoogleSheets);

/* ---------- generación del comprobante en PDF (no editable) ---------- */
const PDF_MARGEN = 40;
let pdfDoc = null;
let pdfCursorY = PDF_MARGEN;
let pdfAnchoUtil = 0;

function pdfVerificarEspacio(alturaNecesaria){
  const alturaPagina = pdfDoc.internal.pageSize.getHeight();
  if(pdfCursorY + alturaNecesaria > alturaPagina - PDF_MARGEN){
    pdfDoc.addPage();
    pdfCursorY = PDF_MARGEN;
  }
}

function pdfEscribirParrafo(texto, opciones = {}){
  const tamano = opciones.tamano || 10;
  const negrita = !!opciones.negrita;
  const interlineado = opciones.interlineado || Math.round(tamano * 1.35);
  const espacioExtra = opciones.espacioDespues || 0;
  pdfDoc.setFont("helvetica", negrita ? "bold" : "normal");
  pdfDoc.setFontSize(tamano);
  const lineas = pdfDoc.splitTextToSize(String(texto), pdfAnchoUtil);
  lineas.forEach(linea=>{
    pdfVerificarEspacio(interlineado);
    pdfDoc.text(linea, PDF_MARGEN, pdfCursorY);
    pdfCursorY += interlineado;
  });
  pdfCursorY += espacioExtra;
}

function pdfAgregarLinea(){
  pdfVerificarEspacio(10);
  pdfDoc.setDrawColor(210,213,220);
  pdfDoc.line(PDF_MARGEN, pdfCursorY, PDF_MARGEN + pdfAnchoUtil, pdfCursorY);
  pdfCursorY += 12;
}

function pdfAgregarPiesDePagina(){
  const totalPaginas = pdfDoc.internal.getNumberOfPages();
  for(let i = 1; i <= totalPaginas; i++){
    pdfDoc.setPage(i);
    pdfDoc.setFont("helvetica", "normal");
    pdfDoc.setFontSize(8);
    pdfDoc.setTextColor(120);
    pdfDoc.text(
      `${sesionActual.nombre} · Grupo ${sesionActual.grupo} · Página ${i} de ${totalPaginas}`,
      PDF_MARGEN, pdfDoc.internal.pageSize.getHeight() - 20
    );
    pdfDoc.setTextColor(0);
  }
}

function generarComprobantePDF(){
  const { jsPDF } = window.jspdf;
  pdfDoc = new jsPDF({ unit: "pt", format: "letter" });
  pdfCursorY = PDF_MARGEN;
  pdfAnchoUtil = pdfDoc.internal.pageSize.getWidth() - PDF_MARGEN * 2;

  pdfEscribirParrafo(TITULO_EXAMEN, { tamano: 14, negrita: true });
  pdfEscribirParrafo(`Comprobante de entrega — generado el ${new Date().toLocaleString("es-MX")}`, { tamano: 9, espacioDespues: 8 });

  pdfEscribirParrafo(`Alumno: ${sesionActual.nombre}`, { tamano: 11, negrita: true });
  pdfEscribirParrafo(`Grupo: ${sesionActual.grupo}`, { tamano: 11 });
  pdfEscribirParrafo(`Hora de inicio: ${formatearFecha(sesionActual.inicio)}`, { tamano: 10 });
  pdfEscribirParrafo(`Hora de entrega: ${formatearFecha(sesionActual.horaEntrega)}`, { tamano: 10 });
  pdfEscribirParrafo(`Tiempo usado: ${formatearDuracionMs(sesionActual.horaEntrega - sesionActual.inicio)}`, { tamano: 10 });
  pdfEscribirParrafo(`¿Entregado automáticamente por tiempo agotado?: ${sesionActual.autoEntregado ? "Sí" : "No"}`, { tamano: 10, espacioDespues: 6 });
  pdfAgregarLinea();

  pdfEscribirParrafo("Resultado", { tamano: 12, negrita: true });
  pdfEscribirParrafo(`Puntos automáticos obtenidos: ${sesionActual.correctas} de ${sesionActual.total}`, { tamano: 10 });
  pdfEscribirParrafo(`Puntos pendientes de revisión manual (preguntas abiertas): ${sesionActual.puntosManualesPosibles}`, { tamano: 10 });
  pdfEscribirParrafo(`Puntaje total posible del examen: ${sesionActual.puntosPosiblesTotales}`, { tamano: 10 });
  pdfEscribirParrafo("Tu calificación final está pendiente hasta que tu profesor(a) revise y asigne los puntos de las preguntas abiertas.", { tamano: 9, espacioDespues: 6 });
  pdfAgregarLinea();

  pdfEscribirParrafo("Integridad del examen", { tamano: 12, negrita: true });
  pdfEscribirParrafo(`Salidas detectadas (pestaña o pantalla completa): ${sesionActual.salidas || 0}`, { tamano: 10 });
  pdfEscribirParrafo(`Tiempo fuera de la pestaña/pantalla completa: ${sesionActual.tiempoFueraTotal || 0} segundos`, { tamano: 10 });
  pdfEscribirParrafo(`Eventos de copiar/pegar detectados: ${sesionActual.eventosCopiarPegar || 0}`, { tamano: 10 });
  pdfEscribirParrafo(`Intentos de captura de pantalla detectados: ${sesionActual.capturasDetectadas || 0}`, { tamano: 10 });
  pdfEscribirParrafo(`Intentos de cambio de aplicación/ventana detectados (Alt+Tab, Cmd+Tab): ${sesionActual.cambiosVentanaDetectados || 0}`, { tamano: 10 });
  pdfEscribirParrafo(`Estado: ${calcularEstado(sesionActual)}`, { tamano: 10, espacioDespues: 6 });
  pdfAgregarLinea();

  pdfEscribirParrafo("Tus respuestas", { tamano: 12, negrita: true, espacioDespues: 4 });

  EXAMEN.preguntas.forEach((pregunta, indice)=>{
    pdfVerificarEspacio(30);
    pdfEscribirParrafo(`${indice+1}. ${pregunta.pregunta}`, { tamano: 10, negrita: true });

    if(pregunta.imagen){
      const anchoImg = 170;
      let altoImg = 100;
      try{
        const propiedades = pdfDoc.getImageProperties(pregunta.imagen);
        altoImg = (propiedades.height * anchoImg) / propiedades.width;
      }catch(err){ /* si por alguna razón no se puede leer, se usa un alto por defecto */ }
      pdfVerificarEspacio(altoImg + 6);
      pdfDoc.addImage(pregunta.imagen, "JPEG", PDF_MARGEN, pdfCursorY, anchoImg, altoImg);
      pdfCursorY += altoImg + 6;
    }

    const respuesta = sesionActual.respuestas[indice];

    if(pregunta.tipo === "asociar"){
      pregunta.items.forEach((item, i)=>{
        const seleccion = (Array.isArray(respuesta) && respuesta[i] !== undefined && respuesta[i] !== null)
          ? pregunta.opciones[respuesta[i]] : "(sin responder)";
        pdfEscribirParrafo(`• ${item} → ${seleccion}`, { tamano: 9.5 });
      });
    } else if(pregunta.tipo === "abierta" || pregunta.tipo === "graficar"){
      const etiqueta = pregunta.tipo === "graficar" ? "Descripción de tu gráfica" : "Respuesta";
      const texto = (typeof respuesta === "string" && respuesta.trim() !== "") ? respuesta.trim() : "(sin responder)";
      pdfEscribirParrafo(`${etiqueta}: ${texto}`, { tamano: 9.5 });
    } else if(pregunta.tipo === "abierta_multiple"){
      pregunta.subpreguntas.forEach((sub, i)=>{
        const texto = (Array.isArray(respuesta) && respuesta[i] && respuesta[i].trim() !== "") ? respuesta[i].trim() : "(sin responder)";
        pdfEscribirParrafo(sub, { tamano: 9.5, negrita: true });
        pdfEscribirParrafo(`Respuesta: ${texto}`, { tamano: 9.5 });
      });
    } else if(pregunta.tipo === "multiple"){
      const seleccionadas = Array.isArray(respuesta) && respuesta.length > 0
        ? respuesta.map(i => pregunta.opciones[i]).join("; ")
        : "(sin responder)";
      pdfEscribirParrafo(`Tus respuestas: ${seleccionadas}`, { tamano: 9.5 });
    } else {
      const seleccion = (respuesta !== undefined && respuesta !== null) ? pregunta.opciones[respuesta] : "(sin responder)";
      pdfEscribirParrafo(`Tu respuesta: ${seleccion}`, { tamano: 9.5 });
    }
    pdfCursorY += 8;
  });

  pdfAgregarPiesDePagina();
  pdfDoc.save(`Comprobante_${normalizar(sesionActual.nombre)}_${sesionActual.grupo}.pdf`);
}

document.getElementById("btn-descargar-pdf").addEventListener("click", generarComprobantePDF);
</script>
