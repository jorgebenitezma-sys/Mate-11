});

/* ---------- sistema antifraude: salir de pantalla completa ---------- */
document.addEventListener("fullscreenchange", ()=>{
  if(!examenActivo) return;

  if(document.fullscreenElement){
    // Confirmado: el examen SÍ está en pantalla completa en este navegador.
    pantallaCompletaFueActivada = true;
    if(horaFueraPantallaCompleta){
      const segundosFuera = Math.round((Date.now() - horaFueraPantallaCompleta)/1000);
      sesionActual.tiempoFueraTotal += segundosFuera;
      horaFueraPantallaCompleta = null;
      registrarEvento(`Regresó a pantalla completa después de ${segundosFuera} segundos fuera.`);
    }
    document.getElementById("bloqueo-pantalla-completa").classList.add("oculto");
    return;
  }

  // document.fullscreenElement es null: ¿de verdad salió de pantalla completa,
  // o es un navegador (ej. Safari en iPhone) que nunca llegó a activarla y
  // solo disparó un evento fantasma? Si nunca se activó de verdad, lo ignoramos
  // por completo: no contamos una salida ni bloqueamos al alumno.
  if(!pantallaCompletaFueActivada) return;

  horaFueraPantallaCompleta = Date.now();
  sesionActual.salidas++;
  registrarEvento(`Salida de pantalla completa #${sesionActual.salidas}.`);
  if(USAR_PANTALLA_COMPLETA){
    document.getElementById("bloqueo-pantalla-completa").classList.remove("oculto");
  }
});
document.getElementById("btn-volver-pantalla-completa").addEventListener("click", ()=>{
